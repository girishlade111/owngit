# LSGit configuration — copy this file to `.env` and edit as needed.
# Real environment variables always take precedence over .env values.

# Port the server listens on
PORT=3000

# Network interface to bind. Use 127.0.0.1 to restrict access to this machine only.
HOST=0.0.0.0

# Maximum accepted archive/upload size, in megabytes
MAX_UPLOAD_MB=200

# Maximum file size (in megabytes) that can be previewed in the code viewer
MAX_PREVIEW_MB=2

# Where repositories, metadata and the audit log are stored.
# Absolute path, or a path relative to the project root.
# DATA_DIR=data
