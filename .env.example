# =============================================================================
# LSGit — Environment Variables Template
# Copy this file to .env and fill in values for your environment
# cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# Core Server
# ---------------------------------------------------------------------------
# Port the HTTP server listens on (server.js:601)
PORT=3000
# Bind host (if you add HOST support in server.js)
# HOST=0.0.0.0
# Node environment
NODE_ENV=development
# Log level for future logger integration
# LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Storage & Limits  (overrides for lib/storage.js defaults)
# ---------------------------------------------------------------------------
# Absolute or relative path to data root (default: <project>/data)  lib/storage.js:7-8
# DATA_DIR=./data
# Max single upload (bytes). Default 200 MB  lib/storage.js:12
# MAX_UPLOAD_BYTES=209715200
# Max file preview size (bytes). Default 2 MB  lib/storage.js:14
# MAX_FILE_VIEW_BYTES=2097152
# Max diff blob size (bytes). Default 1 MB  lib/git.js:12
# MAX_DIFF_BYTES=1048576

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Comma-separated list of blocked extensions (default: .exe,.dll,.so,.bat,.cmd,.sh,.msi,.scr,.com) lib/storage.js:13
# BLOCKED_EXTENSIONS=.exe,.dll,.so,.bat,.cmd,.sh,.msi,.scr,.com
# CORS allowed origins (if you add CORS middleware)
# CORS_ORIGINS=http://localhost:3000
# Rate limit window / max requests (if you add rate limiting)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=100

# ---------------------------------------------------------------------------
# Git Author Identity (lib/git.js:11)
# ---------------------------------------------------------------------------
# GIT_AUTHOR_NAME=LSGit
# GIT_AUTHOR_EMAIL=lsgit@local
# Default branch name (lib/git.js:23)
# GIT_DEFAULT_BRANCH=main
# Commit history depth for log API (lib/git.js:74)
# GIT_LOG_DEPTH=500

# ---------------------------------------------------------------------------
# Audit
# ---------------------------------------------------------------------------
# Path to audit log file (default: <DATA_DIR>/audit.log) lib/storage.js:10
# AUDIT_FILE=./data/audit.log
# Max audit events returned by GET /api/audit (server.js:437)
# AUDIT_MAX_EVENTS=100

# ---------------------------------------------------------------------------
# Frontend / UX Preferences
# ---------------------------------------------------------------------------
# No server env needed — stored in IndexedDB/localStorage as:
#   lsgit-prefs  DB  (public/app.js:52-103)
#   keys: expanded:<projectId>, last:<projectId>, ui:wrap, ui:md
